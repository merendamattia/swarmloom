APP_ENV=production
NODE_ENV=production
FRONTEND_PORT=18420
BACKEND_PORT=18421
PUBLIC_API_URL=https://worker.example.com
FRONTEND_URL=https://worker.example.com

# External PostgreSQL; provision it separately and keep the URL private.
DATABASE_URL=postgresql://github_agent_worker:replace-with-a-long-random-password@postgres.example.internal:5432/github_agent_worker
# External Redis/Valkey endpoint used by BullMQ.
REDIS_URL=rediss://replace-with-redis-host:6380
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-settings-key

GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_REPOSITORIES=owner/repository,owner/another-repository
GITHUB_API_URL=https://api.github.com
GIT_AUTHOR_NAME=github-agent-worker
GIT_AUTHOR_EMAIL=github-agent-worker@users.noreply.github.com
ISSUE_READY_LABEL=agent:ready
ISSUE_WORKING_LABEL=agent:working
ISSUE_BLOCKED_LABEL=agent:blocked
ISSUE_COMPLETED_LABEL=agent:done
ISSUE_DECOMPOSED_LABEL=agent:decomposed
ISSUE_HUMAN_REVIEW_LABEL=agent:human-review

SCHEDULE_CRON=*/30 * * * *
SCHEDULE_TIMEZONE=Europe/Rome
MAX_PARALLEL_JOBS=1
WORKER_ID=production-worker-1
HEARTBEAT_INTERVAL_MS=10000
STALE_JOB_THRESHOLD_MS=60000
AGENT_TIMEOUT_MS=7200000

DATA_DIR=/data
AGENT_RUNTIME_DIR=/app/agent-runtime
AGENT_RUNTIME_HOST_PATH=./agent-runtime

AGENT_PROVIDER=codex
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
CODEX_CLI_VERSION=0.147.0
OPENCODE_CLI_VERSION=1.18.18

# Interactive provider login caches live in the named volumes below.
CODEX_HOME=/data/codex-home
XDG_DATA_HOME=/data/opencode-data
XDG_CONFIG_HOME=/data/opencode-config
OPENCODE_CONFIG_DIR=/data/opencode-config
OPENCODE_PERMISSION={"*":"allow"}

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
