# Port ledger: dashboard 18420, API 18421, Redis host port 18422, PostgreSQL host port 17432.
APP_ENV=local
NODE_ENV=development
FRONTEND_PORT=18420
BACKEND_PORT=18421
POSTGRES_PORT=17432
POSTGRES_DB=swarmloom
POSTGRES_USER=swarmloom
POSTGRES_PASSWORD=swarmloom
DATABASE_URL=postgresql://swarmloom:swarmloom@localhost:17432/swarmloom
REDIS_PORT=18422
REDIS_URL=redis://redis:6379
# 32+ characters; keep this technical secret in the environment, not in runtime settings.
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-settings-key
FRONTEND_URL=http://localhost:18420
PUBLIC_API_URL=http://localhost:18421
ARTIFACT_BASE_URL=http://localhost:18421

# GitHub. Fine-grained token permissions are documented in DEPLOYMENT.md.
GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_REPOSITORIES=owner/repository,owner/another-repository
GITHUB_API_URL=https://api.github.com
GIT_AUTHOR_NAME=swarmloom
GIT_AUTHOR_EMAIL=swarmloom@users.noreply.github.com
ISSUE_READY_LABEL=agent:ready
ISSUE_WORKING_LABEL=agent:working
ISSUE_BLOCKED_LABEL=agent:blocked
ISSUE_COMPLETED_LABEL=agent:done
ISSUE_DECOMPOSED_LABEL=agent:decomposed
ISSUE_READY_TO_MERGE_LABEL=agent:ready-to-merge
ISSUE_HUMAN_REVIEW_LABEL=agent:human-review
PR_REVIEW_REQUESTED_LABEL=agent:review-requested
PR_FIX_REQUESTED_LABEL=agent:fix-requested
PR_REVIEW_PASSED_LABEL=agent:review-passed
MAX_AUTOMATIC_FIX_CYCLES=5
CREATE_DIAGNOSTIC_ISSUES=false

# Scheduler and BullMQ worker. These are bootstrap values; change them later in Settings.
SCHEDULE_CRON=*/30 * * * *
SCHEDULE_TIMEZONE=UTC
MAX_PARALLEL_JOBS=1
WORKER_ID=local-worker-1
HEARTBEAT_INTERVAL_MS=10000
STALE_JOB_THRESHOLD_MS=60000
AGENT_TIMEOUT_MS=7200000

# Persistent paths. Compose overrides DATA_DIR to /data.
DATA_DIR=./data
AGENT_RUNTIME_DIR=./agent-runtime
AGENT_RUNTIME_HOST_PATH=./agent-runtime

# Agent provider. Switch this value without changing code.
AGENT_PROVIDER=codex
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
