  "cards": [
    {
      "dot": "cyan",
      "title": "Control loop",
      "items": [
        "GitHub labels and pull requests are the visible coordination surface",
        "Schedulers and scanners reconcile state before jobs are queued"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability",
      "items": [
        "BullMQ uses Redis/Valkey for delivery and locking",
        "PostgreSQL owns business state, history, and guarded claims"
      ]
    },
    {
      "dot": "violet",
      "title": "Execution",
      "items": [
        "Workers are the only durable-job executors",
        "The runner uses isolated worktrees and provider adapters"
      ]
    },
    {
      "dot": "amber",
      "title": "Operations",
      "items": [
        "The dashboard reads operational state through the API",
        "Telegram receives selected events when notifications are enabled"
      ]
    }
