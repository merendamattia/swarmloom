{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["implemented", "requires_decomposition", "decomposed", "blocked"]
    },
    "summary": { "type": "string" },
    "tests": { "type": ["array", "null"], "items": { "type": "string" } },
    "commit": { "type": ["string", "null"] },
    "pr": {
      "type": ["object", "null"],
      "properties": {
        "number": { "type": "integer" },
        "url": { "type": "string" },
        "base": { "type": "string", "enum": ["develop"] },
        "head": { "type": "string" }
      },
      "required": ["number", "url", "base", "head"],
      "additionalProperties": false
    },
    "visual": {
      "type": ["object", "null"],
      "description": "Required visual evidence when the implementation changes the frontend. Omit (null) for backend-only changes. The worker starts the frontend with setupNote and screenshots the route after it is ready.",
      "properties": {
        "route": {
          "type": "string",
          "description": "Path of the implemented view to screenshot, e.g. \"/settings\". Do not infer it from filenames."
        },
        "setupNote": {
          "type": "string",
          "description": "Shell command that installs dependencies and starts the frontend dev server inside the worktree on the configured visual port, e.g. \"npm ci && npm run dev -- --port 18423\". Provide it whenever the standard dev command is not sufficient."
        }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "reason": { "type": ["string", "null"] },
    "childIssues": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "integer" },
          "url": { "type": "string" },
          "ready": { "type": "boolean" }
        },
        "required": ["number", "url", "ready"],
        "additionalProperties": false
      }
    },
    "question": { "type": ["string", "null"] }
  },
  "required": ["outcome", "summary", "tests", "commit", "pr", "visual", "reason", "childIssues", "question"],
  "additionalProperties": false
}
