{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": { "type": "string", "enum": ["decomposed", "blocked"] },
    "summary": { "type": "string" },
    "childIssues": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "integer" },
          "url": { "type": "string" },
          "ready": { "type": "boolean" }
        },
        "required": ["number", "url", "ready"],
        "additionalProperties": false
      }
    },
    "question": { "type": ["string", "null"] }
  },
  "required": ["outcome", "summary", "childIssues", "question"],
  "additionalProperties": false
}
