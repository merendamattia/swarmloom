{
  "name": "swarmloom-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "build": "bun build src/index.ts src/worker.ts --target bun --outdir dist --external msgpackr-extract",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^6.1.2",
    "croner": "^10.0.0",
    "hono": "^4.12.25",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
