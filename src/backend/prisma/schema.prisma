generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RepositoryStatus {
  PENDING
  READY
  INVALID
  ERROR
}

enum JobStatus {
  QUEUED
  RUNNING
  WAITING_FOR_QUOTA
  COMPLETED
  FAILED
  BLOCKED
  // Historical terminal state; new decomposition jobs are disabled.
  DECOMPOSED
  CANCELLED
  STALE
}

enum JobType {
  IMPLEMENTATION
  FIX
  REVIEW
  // Historical job type; retained so existing job and event history stays readable.
  DECOMPOSITION
}

enum JobSubject {
  ISSUE
  PULL_REQUEST
}

enum ManagedPrState {
  OPEN
  MERGED
  CLOSED
}

enum ManagedPrWorkflow {
  NONE
  REVIEW_REQUESTED
  FIX_REQUESTED
  REVIEW_PASSED
}

enum AgentProvider {
  CODEX
  OPENCODE
}

enum ReviewStatus {
  PENDING
  RUNNING
  PASSED
  CHANGES_REQUESTED
  FAILED
}

enum ScanSource {
  SCHEDULED
  MANUAL
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum EventLevel {
  INFO
  WARNING
  ERROR
}

model Repository {
  id               String           @id @default(cuid())
  fullName         String           @unique
  cloneUrl         String
  localPath        String?
  status           RepositoryStatus @default(PENDING)
  developAvailable Boolean          @default(false)
  baselineCommit   String?
  lastScannedAt    DateTime?
  errorMessage     String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  jobs             Job[]
  events           JobEvent[]
  pullRequests     ManagedPullRequest[]

  @@index([status, fullName])
  @@map("repository")
}

model Job {
  id                      String        @id @default(cuid())
  repositoryId            String
  repository              Repository    @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  scanRunId               String?
  scanRun                  ScanRun?      @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  jobType                 JobType       @default(IMPLEMENTATION)
  subjectType             JobSubject    @default(ISSUE)
  issueNumber             Int
  issueTitle              String
  issueUrl                String
  issueBody               String        @db.Text
  environment             String
  status                   JobStatus     @default(QUEUED)
  activeIssueKey          String?       @unique
  activePrKey             String?       @unique
  queuedAt                DateTime      @default(now())
  startedAt               DateTime?
  activeStartedAt         DateTime?
  completedAt             DateTime?
  durationMs              Int?
  activeDurationMs        Int           @default(0)
  quotaWaitDurationMs     Int           @default(0)
  quotaWaitStartedAt      DateTime?
  quotaResetAt            DateTime?
  quotaWindow             String?
  quotaUsedPercent        Float?
  quotaMessage            String?       @db.Text
  branchName              String
  worktreePath            String?
  worktreeCleanupRequired Boolean       @default(false)
  baselineCommit          String
  pullRequestNumber       Int?
  pullRequestUrl          String?
  pullRequestId           String?
  pullRequest             ManagedPullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  headSha                 String?
  trigger                 String?
  provider                AgentProvider
  model                   String
  reasoningEffort         String?
  sessionId               String?
  inputTokens             BigInt?
  cachedInputTokens       BigInt?
  outputTokens            BigInt?
  reasoningOutputTokens   BigInt?
  totalTokens             BigInt?
  tokenUsageUpdatedAt     DateTime?
  exitCode                Int?
  result                   Json?         @db.JsonB
  errorMessage             String?       @db.Text
  diagnostics              Json?         @db.JsonB
  supportIssueNumber      Int?
  supportIssueUrl         String?
  supportIssueCreating    Boolean       @default(false)
  supportIssueCreatingAt  DateTime?
  supportIssueReconcileRequired Boolean   @default(false)
  workerId                 String?
  claimToken               String?
  cleanupToken             String?
  cleanupLeaseExpiresAt    DateTime?
  attempts                 Int           @default(0)
  heartbeatAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  events                   JobEvent[]
  review                   Review?

  @@index([repositoryId, issueNumber, createdAt])
  @@index([scanRunId, status])
  @@index([environment, status, queuedAt])
  @@index([provider, createdAt])
  @@index([repositoryId, pullRequestNumber])
  @@index([environment, status, quotaWaitStartedAt])
  @@index([environment, status, worktreeCleanupRequired])
  @@map("job")
}

model ManagedPullRequest {
  id                  String           @id @default(cuid())
  repositoryId        String
  repository          Repository       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  prNumber            Int
  issueNumber         Int
  issueTitle          String
  issueUrl            String
  headBranch          String
  headSha             String
  baseBranch          String
  implementationJobId String?
  state               ManagedPrState   @default(OPEN)
  workflow            ManagedPrWorkflow @default(NONE)
  fixReason           String?
  fixDetails          String?          @db.Text
  fixCycleCount       Int              @default(0)
  blocked             Boolean          @default(false)
  lastObservedAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  jobs                Job[]
  reviews             Review[]

  @@unique([repositoryId, prNumber])
  @@index([repositoryId, state])
  @@map("managed_pull_request")
}

model Review {
  id               String             @id @default(cuid())
  jobId            String             @unique
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  claimToken       String?
  pullRequestId    String?
  pullRequest      ManagedPullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  pullRequestNumber Int?
  headSha          String?
  status           ReviewStatus       @default(PENDING)
  provider         AgentProvider
  model            String
  reasoningEffort  String?
  sessionId        String?
  response         String?            @db.Text
  exitCode         Int?
  errorMessage     String?            @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  durationMs       Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("review")
}

model ScanRun {
  id                 String      @id @default(cuid())
  activeEnvironmentKey String?   @unique
  source             ScanSource
  environment        String
  status             ScanStatus  @default(RUNNING)
  startedAt          DateTime    @default(now())
  discoveryCompletedAt DateTime?
  completedAt        DateTime?
  durationMs         Int?
  repositoriesTotal Int         @default(0)
  queuedCount        Int         @default(0)
  successCount       Int         @default(0)
  failureCount       Int         @default(0)
  blockedCount       Int         @default(0)
  // Historical metric retained for existing scan rows.
  decomposedCount    Int         @default(0) @ignore
  pullRequestsCount  Int         @default(0)
  reviewsCount       Int         @default(0)
  queueRemaining     Int         @default(0)
  errorMessage       String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  events             JobEvent[]
  jobs               Job[]

  @@index([environment, startedAt])
  @@map("scan_run")
}

model JobEvent {
  id                String      @id @default(cuid())
  jobId             String?
  job               Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  repositoryId      String?
  repository        Repository? @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  scanRunId         String?
  scanRun            ScanRun?    @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  type              String
  level             EventLevel   @default(INFO)
  message           String       @db.Text
  metadata          Json?        @db.JsonB
  raw               Json?        @db.JsonB
  notifiedAt        DateTime?
  notificationError String?      @db.Text
  createdAt         DateTime     @default(now())

  @@index([jobId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([scanRunId, createdAt])
  @@index([notifiedAt, createdAt])
  @@map("job_event")
}

model ServiceHeartbeat {
  id          String   @id @default(cuid())
  serviceName String
  environment String
  instanceId  String
  metadata    Json?    @db.JsonB
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceName, environment, instanceId])
  @@index([environment, lastSeenAt])
  @@map("service_heartbeat")
}

model RuntimeSetting {
  id          String   @id @default(cuid())
  environment String
  key         String
  value       String   @db.Text
  secret      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([environment, key])
  @@index([environment, updatedAt])
  @@map("runtime_setting")
}

model CodexModel {
  id                     String                         @id @default(cuid())
  slug                   String                         @unique
  label                  String
  description            String                         @db.Text
  enabled                Boolean                        @default(true)
  sortOrder              Int                            @default(0)
  defaultReasoningEffort String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  efforts                CodexModelReasoningEffort[]

  @@index([enabled, sortOrder])
  @@map("codex_model")
}

model CodexReasoningEffort {
  id        String                         @id @default(cuid())
  slug      String                         @unique
  label     String
  enabled   Boolean                        @default(true)
  sortOrder Int                            @default(0)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt
  models    CodexModelReasoningEffort[]

  @@index([enabled, sortOrder])
  @@map("codex_reasoning_effort")
}

model CodexModelReasoningEffort {
  modelId           String
  reasoningEffortId String
  isDefault         Boolean              @default(false)
  model             CodexModel           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  reasoningEffort   CodexReasoningEffort @relation(fields: [reasoningEffortId], references: [id], onDelete: Cascade)

  @@id([modelId, reasoningEffortId])
  @@index([reasoningEffortId])
  @@map("codex_model_reasoning_effort")
}

model DashboardExceptionAcknowledgement {
  environment   String   @id
  acknowledgedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("dashboard_exception_acknowledgement")
}
