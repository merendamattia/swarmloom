generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RepositoryStatus {
  PENDING
  READY
  INVALID
  ERROR
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  DECOMPOSED
  CANCELLED
  STALE
}

enum AgentProvider {
  CODEX
  OPENCODE
}

enum ReviewStatus {
  PENDING
  RUNNING
  PASSED
  CHANGES_REQUESTED
  FAILED
}

enum ScanSource {
  SCHEDULED
  MANUAL
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum EventLevel {
  INFO
  WARNING
  ERROR
}

model Repository {
  id               String           @id @default(cuid())
  fullName         String           @unique
  cloneUrl         String
  localPath        String?
  status           RepositoryStatus @default(PENDING)
  developAvailable Boolean          @default(false)
  baselineCommit   String?
  lastScannedAt    DateTime?
  errorMessage     String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  jobs             Job[]
  events           JobEvent[]

  @@index([status, fullName])
  @@map("repository")
}

model Job {
  id                      String        @id @default(cuid())
  repositoryId            String
  repository              Repository    @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  scanRunId               String?
  scanRun                  ScanRun?      @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  issueNumber             Int
  issueTitle              String
  issueUrl                String
  issueBody               String        @db.Text
  environment             String
  status                   JobStatus     @default(QUEUED)
  activeIssueKey          String?       @unique
  queueJobId               String        @unique
  queuedAt                DateTime      @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  durationMs              Int?
  branchName              String
  worktreePath            String?
  baselineCommit          String
  pullRequestNumber       Int?
  pullRequestUrl          String?
  provider                AgentProvider
  model                   String
  reasoningEffort         String?
  implementationSessionId String?
  exitCode                Int?
  result                   Json?         @db.JsonB
  errorMessage             String?       @db.Text
  diagnostics              Json?         @db.JsonB
  workerId                 String?
  attempts                 Int           @default(0)
  heartbeatAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  events                   JobEvent[]
  review                   Review?

  @@index([repositoryId, issueNumber, createdAt])
  @@index([scanRunId, status])
  @@index([environment, status, queuedAt])
  @@index([provider, createdAt])
  @@map("job")
}

model Review {
  id              String        @id @default(cuid())
  jobId           String        @unique
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          ReviewStatus  @default(PENDING)
  provider        AgentProvider
  model           String
  reasoningEffort String?
  sessionId       String?
  verdict         Json?         @db.JsonB
  findings        Json?         @db.JsonB
  exitCode        Int?
  errorMessage    String?       @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("review")
}

model ScanRun {
  id                 String      @id @default(cuid())
  activeEnvironmentKey String?   @unique
  source             ScanSource
  environment        String
  status             ScanStatus  @default(RUNNING)
  startedAt          DateTime    @default(now())
  discoveryCompletedAt DateTime?
  completedAt        DateTime?
  durationMs         Int?
  repositoriesTotal Int         @default(0)
  queuedCount        Int         @default(0)
  successCount       Int         @default(0)
  failureCount       Int         @default(0)
  blockedCount       Int         @default(0)
  decomposedCount    Int         @default(0)
  pullRequestsCount  Int         @default(0)
  reviewsCount       Int         @default(0)
  queueRemaining     Int         @default(0)
  errorMessage       String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  events             JobEvent[]
  jobs               Job[]

  @@index([environment, startedAt])
  @@map("scan_run")
}

model JobEvent {
  id                String      @id @default(cuid())
  jobId             String?
  job               Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  repositoryId      String?
  repository        Repository? @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  scanRunId         String?
  scanRun            ScanRun?    @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  type              String
  level             EventLevel   @default(INFO)
  message           String       @db.Text
  metadata          Json?        @db.JsonB
  raw               Json?        @db.JsonB
  notifiedAt        DateTime?
  notificationError String?      @db.Text
  createdAt         DateTime     @default(now())

  @@index([jobId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([scanRunId, createdAt])
  @@index([notifiedAt, createdAt])
  @@map("job_event")
}

model ServiceHeartbeat {
  id          String   @id @default(cuid())
  serviceName String
  environment String
  instanceId  String
  metadata    Json?    @db.JsonB
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceName, environment, instanceId])
  @@index([environment, lastSeenAt])
  @@map("service_heartbeat")
}

model RuntimeSetting {
  id          String   @id @default(cuid())
  environment String
  key         String
  value       String   @db.Text
  secret      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([environment, key])
  @@index([environment, updatedAt])
  @@map("runtime_setting")
}
