{
  "name": "github-agent-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "repository": {"type": "git", "url": "git+https://github.com/merendamattia/github-agent-worker.git"},
  "workspaces": ["src/backend", "src/frontend"],
  "scripts": {
    "dev": "bun run dev:backend & bun run dev:worker & bun run dev:frontend & wait",
    "dev:backend": "bun --filter github-agent-worker-backend dev",
    "dev:worker": "bun --filter github-agent-worker-backend worker",
    "dev:frontend": "bun --filter github-agent-worker-frontend dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "lint": "bun --filter github-agent-worker-frontend lint",
    "typecheck": "bun --filter '*' typecheck",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "check:commit": "pre-commit run conventional-pre-commit --hook-stage commit-msg --commit-msg-filename .git/COMMIT_EDITMSG",
    "db:generate": "bun --filter github-agent-worker-backend db:generate",
    "db:migrate": "bun --filter github-agent-worker-backend db:migrate",
    "db:deploy": "bun --filter github-agent-worker-backend db:deploy"
  }
}
